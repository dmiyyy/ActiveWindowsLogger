[Unit]
Description=Active windows logger
Documentation=https://github.com/dmiyyy/ActiveWindowsLogger
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/activewindowslogger
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
